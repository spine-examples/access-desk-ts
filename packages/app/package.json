{
  "name": "@access-desk/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "compose": "spine-proto compose",
    "generate": "pnpm run compose",
    "build": "spine-proto compose && tsc -b",
    "build:ts": "tsc -b",
    "typecheck": "spine-proto compose && tsc -b --pretty false",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "server": "node --env-file-if-exists=../../.env dist/src/server/main.js",
    "gateway": "node --env-file-if-exists=../../.env dist/src/gateway/main.js",
    "session-key": "node scripts/session-key.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-event-engine/auth": "2.0.0-snapshot.25",
    "@spine-event-engine/client-node": "2.0.0-snapshot.25",
    "@spine-event-engine/core": "2.0.0-snapshot.25",
    "@spine-event-engine/proto": "2.0.0-snapshot.25",
    "@spine-event-engine/server": "2.0.0-snapshot.25",
    "@spine-event-engine/storage": "2.0.0-snapshot.25",
    "@spine-event-engine/storage-postgres": "2.0.0-snapshot.25",
    "@access-desk/identity-model": "0.0.0",
    "@access-desk/resources-model": "0.0.0",
    "@access-desk/identity-server": "0.0.0",
    "@access-desk/resources-server": "0.0.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@access-desk/testing": "0.0.0",
    "@spine-event-engine/client-web": "2.0.0-snapshot.25",
    "@spine-event-engine/proto-tools": "2.0.0-snapshot.25",
    "@types/node": "24.13.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
