{
  "name": "@access-desk/access-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/generated/proto-module.d.ts",
      "default": "./dist/generated/proto-module.js"
    },
    "./spine-proto-manifest.json": "./spine-proto-manifest.json",
    "./proto/*": "./proto/*",
    "./generated/*.js": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "scripts": {
    "generate": "spine-proto generate",
    "build": "spine-proto generate && tsc -b",
    "build:ts": "tsc -b",
    "typecheck": "spine-proto generate && tsc -b --pretty false",
    "lint": "eslint src --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@spine-event-engine/proto": "2.0.0-snapshot.2"
  },
  "devDependencies": {
    "@spine-event-engine/proto-tools": "2.0.0-snapshot.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
