{
  "name": "@access-desk/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "cert": "mkdir -p .certs && openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj /CN=localhost -addext subjectAltName=DNS:localhost,IP:127.0.0.1 -keyout .certs/localhost-key.pem -out .certs/localhost.pem"
  },
  "dependencies": {
    "@access-desk/identity-model": "0.0.0",
    "@access-desk/resources-model": "0.0.0",
    "@bufbuild/protobuf": "2.12.1",
    "@spine-event-engine/client-react": "2.0.0-snapshot.29",
    "@spine-event-engine/client-web": "2.0.0-snapshot.29",
    "@spine-event-engine/core": "2.0.0-snapshot.29",
    "@spine-event-engine/proto": "2.0.0-snapshot.29",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.3"
  }
}
