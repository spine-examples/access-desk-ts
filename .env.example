#
# The configuration of Access Desk.
#
# Copy this file to `.env` beside it, in the root of the repository, and fill
# it in. `.env` is ignored by Git. Never commit real secrets.
#
# Every setting is required. A program that misses one refuses to start and
# says which.
#

# Where the application server listens. The gateway reaches it there. It
# trusts whoever can reach it to say who is acting, so have it listen only
# where the gateway can reach it.
ACCESS_DESK_SERVER_HOST=127.0.0.1
ACCESS_DESK_SERVER_PORT=8090

# Where the gateway listens. The web client's development server reaches it
# there.
ACCESS_DESK_GATEWAY_HOST=127.0.0.1
ACCESS_DESK_GATEWAY_PORT=8080

# Where the web client listens. An identity provider sends a
# person back to that address, so register it with each provider as the
# callback address.
ACCESS_DESK_WEB_HOST=127.0.0.1
ACCESS_DESK_WEB_PORT=5173

# Where the web client calls the application.
# The page reads it at `/config.json` as it opens.
ACCESS_DESK_API_HOST=127.0.0.1
ACCESS_DESK_API_PORT=8443

# Google, the identity provider people sign in through.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The PostgreSQL server for the application server and the gateway, and the
# account they connect with. For development, `pnpm run postgres:start` runs
# one in Docker at this address and port, with this account, and creates the
# databases below that do not exist yet. Docker needs an IP address here, and
# 127.0.0.1 keeps the server reachable from this machine only. The password is
# set on the first start; to change it later, delete the data with
# `pnpm run postgres:delete`.
ACCESS_DESK_DATABASE_HOST=127.0.0.1
ACCESS_DESK_DATABASE_PORT=5432
ACCESS_DESK_DATABASE_USER=accessdesk
ACCESS_DESK_DATABASE_PASSWORD=

# The organizations the application server keeps, separated by commas. Each
# is named by letters, digits, `-`, and `_`, at most 42 of them, and keeps its
# data in the database `accessdesk_resources_<organization>`. A new
# organization needs its database and a restart.
ACCESS_DESK_ORGANIZATIONS=teamdev,codematters

# The key the gateway signs session tokens with: a P-256 private key, in
# base64. People stay signed in when the gateway restarts, and changing the key
# signs everyone out. Generate one with `pnpm --dir packages/app run session-key`.
# Keep it secret: anyone who has it can sign in as any person.
ACCESS_DESK_SESSION_KEY=
