#
# The configuration of Access Desk.
#
# Copy this file to `.env` beside it, in the root of the repository, and fill
# it in. `.env` is ignored by Git. Never commit real secrets.
#
# Every setting is required. A program that misses one refuses to start and
# says which.
#

# Where the application server listens. The gateway reaches it there. It
# trusts whoever can reach it to say who is acting, so have it listen only
# where the gateway can reach it.
ACCESS_DESK_SERVER_HOST=127.0.0.1
ACCESS_DESK_SERVER_PORT=8090

# Where the gateway listens. The web client's development server reaches it
# there.
ACCESS_DESK_GATEWAY_HOST=127.0.0.1
ACCESS_DESK_GATEWAY_PORT=8080

# Where the web client listens. An identity provider sends a
# person back to that address, so register it with each provider as the
# callback address.
ACCESS_DESK_WEB_HOST=127.0.0.1
ACCESS_DESK_WEB_PORT=5173

# Google, the identity provider people sign in through.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the programs keep what they must remember: `memory`, which forgets
# everything when a program stops, or `postgresql`, which keeps it in the
# databases below.
ACCESS_DESK_STORAGE=postgresql

# The PostgreSQL server the programs keep their data on, and the account they
# sign in with. `pnpm run postgres:start` runs one in Docker for development,
# at this address and port, with this account, and makes the databases below
# that are missing. Docker needs an IP address here, and 127.0.0.1 keeps the
# server to this machine. Its password is set when it first starts; to change
# it later, delete the data with `pnpm run postgres:delete`. Needed only for
# `postgresql`.
ACCESS_DESK_DATABASE_HOST=127.0.0.1
ACCESS_DESK_DATABASE_PORT=5432
ACCESS_DESK_DATABASE_USER=accessdesk
ACCESS_DESK_DATABASE_PASSWORD=

# The database where the application server keeps people, the accounts they
# sign in with, their email addresses, and their memberships. Needed only for
# `postgresql`.
ACCESS_DESK_IDENTITY_DATABASE=accessdesk_identity

# The organizations the application server keeps, each in a database of its
# own. Spine's PostgreSQL storage must know every organization when it opens,
# so the server keeps only these, and refuses any other. Local development has
# two, teamdev and codematters, whose databases `pnpm run postgres:start`
# makes. `{organization}` in the database's name is where each one's name
# goes. Needed only for `postgresql`; in memory, any organization is kept.
ACCESS_DESK_ORGANIZATIONS=teamdev,codematters
ACCESS_DESK_ORGANIZATION_DATABASE=accessdesk_resources_{organization}

# The database where the application server keeps what people subscribed to
# in the organizations. Each organization is kept in a database of its own,
# and a subscription belongs to none of them, so subscriptions have a database
# of their own; Identity keeps its subscriptions in its own database. Needed
# only for `postgresql`.
ACCESS_DESK_RESOURCES_SUBSCRIPTIONS_DATABASE=accessdesk_resources_subscriptions

# The database where the gateway keeps the subscriptions people hold and the
# sessions they ended. Needed only for `postgresql`.
ACCESS_DESK_GATEWAY_DATABASE=accessdesk_gateway

# The key the gateway signs sessions with. Sessions stay good across a restart
# of the gateway while it stays the same, and replacing it signs everybody out.
# Make one with `pnpm --dir packages/app run session-key`. Keep it secret:
# whoever has it can sign in as anybody.
ACCESS_DESK_SESSION_KEY=

# Where a test run that names no storage keeps the tests' data, such as one
# from an editor: `memory`, or `postgresql`. `pnpm run test` always keeps it in
# memory, and `pnpm run test:postgresql` always in PostgreSQL.
ACCESS_DESK_TEST_STORAGE=memory

# The database `pnpm run test:postgresql` connects to, on the server above, to
# make the throwaway databases of the tests, which it deletes when they finish.
ACCESS_DESK_TEST_DATABASE=accessdesk_test
