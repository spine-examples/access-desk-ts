#
# The configuration of Access Desk.
#
# Copy this file to `.env` beside it, in the root of the repository, and fill
# it in. `.env` is ignored by Git. Never commit real secrets.
#
# The addresses and ports are all required. Of the two identity providers,
# at least one is required. A program that misses a setting it needs refuses
# to start and says which.
#

# Where the application server listens. The gateway reaches it there. It
# trusts whoever can reach it to say who is acting, so have it listen only
# where the gateway can reach it.
ACCESS_DESK_SERVER_HOST=127.0.0.1
ACCESS_DESK_SERVER_PORT=8090

# Where the gateway listens. The web client's development server reaches it
# there.
ACCESS_DESK_GATEWAY_HOST=127.0.0.1
ACCESS_DESK_GATEWAY_PORT=8080

# Where the web client listens. An identity provider sends a
# person back to that address, so register it with each provider as the
# callback address.
ACCESS_DESK_WEB_HOST=127.0.0.1
ACCESS_DESK_WEB_PORT=5173

# Identity providers. At least one is required: GitHub, Google, or both.
# Set both of a provider's settings, and leave both empty for a provider that is not used.

# GitHub OAuth application.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
